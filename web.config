# thranpages web.config file
# Thransoft 08-01-20 A.D

##### EDIT BETWEEN THESE LINES TO HAVE MATCHING PATHS ####
##### THIS IS FOR THE DEV ENVIRONMENT #####
userName="mjb"
rootDir="/home/$userName/nginx"
htmlDir="$rootDir/www/"
# These need pathnames escaped for SED.
wwwroot='\/home\/mjb\/nginx\/www'

##### EDIT THESE TO MATCH YOUR LIVE ENVIRONMENT #####

liveUserName="root"
liveRootDir="/var/www"
liveHtmlDest="/var/" # used with upload.sh
liveHtmlDir="$liveRootDir/html"
liveWwwRootSed='\/var\/www'

liveProjRoot="/tmp/"
liveProjDir="$liveProjRoot/wkdir"

##########################################################

nginxConfigDir="/etc/nginx/"
siteName="Thranpages"
#awstatsExtra="libnet-dns-perl libnet-ip-perl libgeo-ipfree-perl liburi-perl"
# apache2-utils is httpd-utils on centos
dependencies="nginx fcgiwrap certbot python-certbot-nginx awstats libgeo-ipfree-perl apache2-utils rsync"
# Should have an edited nginx.conf and any sites
nginxConfig="config/*"
# Where SED throws edited config before copy or zip (temp dir)
nginxConfigSrc="config_edited/"

# update.sh specific config
SSH_PORT="1661"
setupFiles="$nginxConfig setup.sh web.config"
htmlFiles="www/*"
uploadSvr="root@104.238.130.98"
uploadURL="${uploadSvr}:${liveProjDir}"
